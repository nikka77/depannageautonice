# Variables du relais de recherche par plaque (api/plaque.js).
# Ce fichier est un MODÈLE : il ne contient aucune vraie valeur et il est
# versionné. Les vraies valeurs se saisissent dans Vercel →
# Settings → Environment Variables, jamais dans le dépôt.

# Jeton Auto Ways (https://app.auto-ways.net/api-keys)
AUTOWAYS_TOKEN=

# Origines autorisées à appeler le relais, séparées par des virgules
ALLOWED_ORIGINS=https://nikka77.github.io,http://localhost:8123

# Mettre à 1 temporairement pour voir la réponse brute d'Auto Ways
# et ajuster la correspondance des champs. À remettre à vide ensuite.
DEBUG_PLAQUE=
